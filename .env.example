# OXM Vision — variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# .env NUNCA debe entrar a git.

# ─────────────────────────────────────────────────────────────
# Anthropic (chat lenguaje natural + reporte diario)
# ─────────────────────────────────────────────────────────────
# Obtén una en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Telegram (alertas de audio + reporte diario)
# Crea un bot con @BotFather → /newbot → copia el token
# Obtén tu chat_id enviando un mensaje al bot y consultando:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# ─────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Hora local (CST) para el reporte diario automático
REPORT_HOUR_CST=8

# ─────────────────────────────────────────────────────────────
# Paths del host (montados como volúmenes en el container)
# ─────────────────────────────────────────────────────────────
# Carpeta con los modelos YOLO: yolo26s.pt, yolo26s.onnx, yolo26s.engine
YOLO_DIR=./yolo

# Carpeta runtime: events.db, audio_clips/, face_snaps/, face_db.pkl
DATA_DIR=./data

# Modelos InsightFace (descarga inicial automática)
INSIGHTFACE_DIR=./models/insightface

# Cache de Whisper / HuggingFace
WHISPER_CACHE=./models/whisper_cache

# ─────────────────────────────────────────────────────────────
# Nemotron Omni (opcional — limpieza de transcripciones + reporte diario)
# Levantar un servidor OpenAI-compatible (vLLM o similar) con el modelo
# nemotron-omni en algún host de tu red.
# ─────────────────────────────────────────────────────────────
NEMOTRON_URL=http://localhost:8003/v1

